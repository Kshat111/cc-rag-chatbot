# Copy to .env and fill in locally. Never commit .env.
# Names only, no real values here. Set the one for your provider (see README, "Choosing an LLM").
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama needs no key. Optional overrides: RAGBOT_LLM_PROVIDER, RAGBOT_LLM_BASE_URL,
# RAGBOT_LLM_MODEL, RAGBOT_LLM_API_KEY_ENV
