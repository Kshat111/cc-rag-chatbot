# Copy to .env and fill in locally. Never commit .env.
# Set the key for the provider you want to use (see README, "Supported LLM providers").
# You only need ONE of these.

OPENAI_API_KEY=          # OpenAI / ChatGPT   — platform.openai.com
OPENROUTER_API_KEY=      # Anthropic / Claude — openrouter.ai  (also covers openrouter preset)
GEMINI_API_KEY=          # Google Gemini      — aistudio.google.com/apikey
GITHUB_TOKEN=            # GitHub Copilot     — github.com/settings/tokens
XAI_API_KEY=             # xAI Grok           — console.x.ai
DASHSCOPE_API_KEY=       # Alibaba Qwen       — dashscope.console.aliyun.com
GROQ_API_KEY=            # Groq               — console.groq.com
# Ollama needs no key. Run: ollama serve && ollama pull llama3.2

# Optional overrides (all providers):
# RAGBOT_LLM_PROVIDER=openai        # which preset to use
# RAGBOT_LLM_BASE_URL=              # override the base URL
# RAGBOT_LLM_MODEL=                 # override the model name
# RAGBOT_LLM_API_KEY_ENV=           # name of the env var that holds the key
